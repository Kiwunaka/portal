{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pokrov.space/schemas/release_handoff_metadata.schema.json",
  "title": "POKROV Release Handoff Metadata",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "client_lane": {
      "type": "string",
      "enum": [
        "bridge",
        "pokrov-app"
      ]
    },
    "release_version": {
      "type": "string",
      "minLength": 1
    },
    "artifact_dir": {
      "type": "string",
      "minLength": 1
    },
    "downloads": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "android": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "play_url": {
              "type": "string"
            },
            "apk_url": {
              "type": "string"
            },
            "apk_arm64_url": {
              "type": "string"
            },
            "apk_armeabi_v7a_url": {
              "type": "string"
            },
            "apk_x86_64_url": {
              "type": "string"
            },
            "apk_universal_url": {
              "type": "string"
            },
            "apk_variants": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "abi": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string"
                  },
                  "size_bytes": {
                    "type": "integer"
                  }
                }
              }
            },
            "mirror_url": {
              "type": "string"
            }
          }
        },
        "windows": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "exe_url": {
              "type": "string"
            },
            "mirror_url": {
              "type": "string"
            }
          }
        },
        "docs_url": {
          "type": "string"
        }
      }
    },
    "runtime_env": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "APP_ANDROID_PLAY_URL": {
          "type": "string"
        },
        "APP_ANDROID_APK_URL": {
          "type": "string"
        },
        "APP_ANDROID_APK_ARM64_URL": {
          "type": "string"
        },
        "APP_ANDROID_APK_ARMEABI_V7A_URL": {
          "type": "string"
        },
        "APP_ANDROID_APK_X86_64_URL": {
          "type": "string"
        },
        "APP_ANDROID_APK_UNIVERSAL_URL": {
          "type": "string"
        },
        "APP_ANDROID_MIRROR_URL": {
          "type": "string"
        },
        "APP_ANDROID_VERSION": {
          "type": "string"
        },
        "APP_ANDROID_SHA256": {
          "type": "string"
        },
        "APP_ANDROID_SIZE_BYTES": {
          "type": "string"
        },
        "APP_ANDROID_ARM64_SHA256": {
          "type": "string"
        },
        "APP_ANDROID_ARM64_SIZE_BYTES": {
          "type": "string"
        },
        "APP_ANDROID_ARMEABI_V7A_SHA256": {
          "type": "string"
        },
        "APP_ANDROID_ARMEABI_V7A_SIZE_BYTES": {
          "type": "string"
        },
        "APP_ANDROID_X86_64_SHA256": {
          "type": "string"
        },
        "APP_ANDROID_X86_64_SIZE_BYTES": {
          "type": "string"
        },
        "APP_ANDROID_UNIVERSAL_SHA256": {
          "type": "string"
        },
        "APP_ANDROID_UNIVERSAL_SIZE_BYTES": {
          "type": "string"
        },
        "APP_WINDOWS_EXE_URL": {
          "type": "string"
        },
        "APP_WINDOWS_MIRROR_URL": {
          "type": "string"
        },
        "APP_WINDOWS_VERSION": {
          "type": "string"
        },
        "APP_WINDOWS_SHA256": {
          "type": "string"
        },
        "APP_WINDOWS_SIZE_BYTES": {
          "type": "string"
        },
        "APP_DOCS_URL": {
          "type": "string"
        }
      }
    }
  }
}
