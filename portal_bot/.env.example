WEBAPP_SESSION_SECRET=
APP_ACCESS_TOKEN_TTL_SECONDS=900
APP_REFRESH_TOKEN_TTL_SECONDS=2592000
APP_FRESH_AUTH_MAX_AGE_SECONDS=600
RECOVERY_CODE_HMAC_SECRET=
RECOVERY_CODE_HMAC_VERSION=1
# During HMAC-key rotation retain previous versions as RECOVERY_CODE_HMAC_SECRET_V1, _V2, etc.
# WEBAPP_SESSION_SECRET is a compatibility fallback; production should use the dedicated recovery secret.
ANTIABUSE_HMAC_SECRET=
ANTIABUSE_HMAC_VERSION=1
# Dedicated backend-only pepper. Never reuse auth, payment, Telegram, or recovery secrets.
# During rotation retain active prior versions as ANTIABUSE_HMAC_SECRET_V1, _V2, etc.
# Retention values are hard-capped in code at 72 hours / 7 days / 90 days.
ANTIABUSE_RAW_IP_RETENTION_HOURS=72
ANTIABUSE_FULL_IP_HMAC_RETENTION_DAYS=7
ANTIABUSE_PREFIX_HMAC_RETENTION_DAYS=90
ANTIABUSE_RETENTION_BATCH_LIMIT=1000
ANTIABUSE_RETENTION_MAX_BATCHES_PER_RUN=20
ANTIABUSE_RETENTION_INTERVAL_SECONDS=300
API_RATE_LIMIT_EMAIL_OTP_START_PER_MINUTE=5
API_RATE_LIMIT_EMAIL_OTP_START_IP_PER_MINUTE=20
API_RATE_LIMIT_EMAIL_OTP_FINISH_PER_MINUTE=8
API_RATE_LIMIT_EMAIL_OTP_FINISH_IP_PER_MINUTE=30
API_RATE_LIMIT_EMAIL_OTP_FINISH_INSTALL_PER_MINUTE=8
