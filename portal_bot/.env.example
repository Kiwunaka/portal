PLATIMA_PROJECT_ID=
PLATIMA_API_KEY_PROJECT=
LAVATOP_API_BASE_URL=https://gate.lava.top
LAVATOP_API_KEY=
# Current production pattern: use one hidden API-only dynamic-price Lava.top
# offer for every POKROV plan and discount. Set plan overrides to the same id
# unless a deliberately separate fixed-price offer is being tested.
LAVATOP_OFFER_ID=
LAVATOP_OFFER_ID_START_99=
LAVATOP_WEBHOOK_API_KEY=
LAVATOP_WEBHOOK_BASIC_USERNAME=
LAVATOP_WEBHOOK_BASIC_PASSWORD=
LAVATOP_WEBHOOK_IP_ALLOWLIST=158.160.60.174
LAVATOP_REQUEST_TIMEOUT_SECONDS=30
LAVATOP_DYNAMIC_AMOUNT_ENABLED=true
LAVATOP_BUYER_LANGUAGE=RU
LAVATOP_DEFAULT_BUYER_EMAIL=
