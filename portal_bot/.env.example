# Email auth delivery is webhook-only. Prefer EMAIL_DELIVERY_WEBHOOK_URL; EMAIL_AUTH_WEBHOOK_URL is a compatibility alias.
# Run portal_bot/email_relay_app.py as the internal SMTP bridge and keep SMTP credentials in env/secret manager.
APP_ANDROID_PLAY_URL=
APP_ANDROID_APK_URL=
APP_ANDROID_MIRROR_URL=
APP_WINDOWS_EXE_URL=
APP_WINDOWS_MIRROR_URL=
APP_DOCS_URL=
# Release handoff:
# keep the app download/docs URLs blank here and inject the published values via env/secret manager.
# Do not leave bot fallbacks pointed at third-party clients or old release repos for production.
WEBAPP_ENABLE_HAPTIC=true
WEBAPP_ENABLE_LOTTIE=true
PROFILE_UPDATE_INTERVAL_HOURS=6

# Capacity-aware smart-connect and subscription steering.
# Disable enforcement flags for rollback; metrics and additive tables remain safe to keep collecting.
CAPACITY_AWARE_NODE_SELECTION=true
SUBSCRIPTION_DYNAMIC_ORDERING=true
SUBSCRIPTION_EXCLUDE_HARD_REJECT=false
KEY_PRESSURE_SCORING=true
KEY_PRESSURE_FAIR_USE_ROUTING=false
APP_NODES_SELECT_ENDPOINT=true
XRAY_METRICS_COLLECTOR=true
NODE_AGENT_METRICS=true
USERNODE_MAPPING_AS_CANDIDATE_LIMIT=false
SMART_CONNECT_SHORTLIST_LIMIT=8
SMART_CONNECT_STICKINESS_THRESHOLD_PERCENT=20
SMART_CONNECT_STALE_AFTER_SECONDS=180
SMART_CONNECT_CPU_REJECT_PERCENT=85
SMART_CONNECT_TX_SOFT_RATIO=0.70
SMART_CONNECT_TX_DRAIN_RATIO=0.82
SMART_CONNECT_TX_HARD_RATIO=0.92
SMART_CONNECT_MAX_PACKET_LOSS_PERCENT=2
SMART_CONNECT_MAX_TCP_RETRANS_PERCENT=5
NODE_METRICS_PORT_CAPACITY_MBPS=1000

