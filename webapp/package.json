{
  "name": "pokrov-webapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build && node ./scripts/fix-export-segment-paths.mjs",
    "start": "next start",
    "lint": "eslint",
    "generate:favicon": "node ./scripts/generate-favicon.mjs",
    "test:public-errors": "node --test ./scripts/public-error-messages.test.mjs",
    "test:e2e": "node ./scripts/run-e2e.mjs full",
    "test:e2e:admin": "node ./scripts/run-e2e.mjs admin",
    "test:e2e:cabinet": "node ./scripts/run-e2e.mjs cabinet",
    "test:e2e:admin:headed": "node ./scripts/run-e2e.mjs admin --headed",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.34.2",
    "lucide-react": "^0.575.0",
    "next": "16.1.6",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
