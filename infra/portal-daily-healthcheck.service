[Unit]
Description=POKROV daily panel/node health summary
After=network-online.target portal-api.service
Wants=network-online.target portal-api.service

[Service]
Type=oneshot
WorkingDirectory=/root/portal_bot
EnvironmentFile=-/root/portal_bot/.env
ExecStart=/root/portal_bot/venv/bin/python /root/portal_bot/daily_panel_node_healthcheck.py
User=root
