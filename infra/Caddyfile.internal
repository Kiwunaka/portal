{
  auto_https disable_redirects
  servers :80 {
    protocols h1 h2
  }
  servers :8444 {
    protocols h1 h2
    listener_wrappers {
      proxy_protocol {
        timeout 2s
        allow 127.0.0.1/32 ::1/128
        fallback_policy skip
      }
      tls
    }
  }
}

# Internal Caddy listener behind HAProxy TCP passthrough.
# External :443 is terminated/passed by L4 on brain.

http://pokrov.space, http://www.pokrov.space, http://app.pokrov.space, http://www.app.pokrov.space, http://admin.pokrov.space, http://www.admin.pokrov.space, http://connect.pokrov.space, http://www.connect.pokrov.space, http://api.pokrov.space, http://www.api.pokrov.space, http://pay.pokrov.space, http://www.pay.pokrov.space, http://portal-privacy.online, http://www.portal-privacy.online, http://connect.portal-privacy.online, http://kiwunaka.space, http://www.kiwunaka.space, http://pay.kiwunaka.space {
  redir https://{host}{uri} 308
}

pokrov.space:8444, www.pokrov.space:8444, app.pokrov.space:8444, www.app.pokrov.space:8444, admin.pokrov.space:8444, www.admin.pokrov.space:8444, connect.pokrov.space:8444, www.connect.pokrov.space:8444, api.pokrov.space:8444, www.api.pokrov.space:8444, pay.pokrov.space:8444, www.pay.pokrov.space:8444, portal-privacy.online:8444, www.portal-privacy.online:8444, connect.portal-privacy.online:8444, kiwunaka.space:8444, www.kiwunaka.space:8444, pay.kiwunaka.space:8444 {
  encode zstd gzip
  header {
    Alt-Svc "clear"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
    Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
    X-Frame-Options "DENY"
    -Server
  }

  @www_marketing host www.pokrov.space
  handle @www_marketing {
    redir https://pokrov.space{uri} 308
  }

  @www_webapp host www.app.pokrov.space
  handle @www_webapp {
    redir https://app.pokrov.space{uri} 308
  }

  @www_connect host www.connect.pokrov.space
  handle @www_connect {
    redir https://connect.pokrov.space{uri} 308
  }

  @www_api host www.api.pokrov.space
  handle @www_api {
    redir https://api.pokrov.space{uri} 308
  }

  @www_pay host www.pay.pokrov.space
  handle @www_pay {
    redir https://pay.pokrov.space{uri} 308
  }

  @marketing_hosts host pokrov.space
  handle @marketing_hosts {
    @apex_api path /api/* /pay/* /s8Kx2mP7qR4wT/*
    redir @apex_api https://api.pokrov.space{uri} 308

    @marketing_static path /_next/static/*
    @marketing_html {
      not path /_next/static/*
    }
    header @marketing_static Cache-Control "public, max-age=31536000, immutable"
    header @marketing_html Cache-Control "no-cache, must-revalidate"
    handle {
      root * /var/www/portal/marketing
      try_files {path} {path}/index.html /index.html
      file_server
    }
  }

  @webapp_host host app.pokrov.space
  handle @webapp_host {
    header {
      -X-Frame-Options
      Content-Security-Policy "frame-ancestors https://web.telegram.org https://*.telegram.org; base-uri 'self'; object-src 'none'"
    }
    @webapp_static path /_next/static/*
    @webapp_html {
      not path /_next/static/*
    }
    header @webapp_static Cache-Control "public, max-age=31536000, immutable"
    header @webapp_html Cache-Control "no-cache, must-revalidate"
    root * /var/www/portal/webapp
    try_files {path} {path}/index.html /index.html
    file_server
  }

  @adminapp_host host admin.pokrov.space www.admin.pokrov.space
  handle @adminapp_host {
    @adminapp_static path /_next/static/*
    @adminapp_html {
      not path /_next/static/*
    }
    header @adminapp_static Cache-Control "public, max-age=31536000, immutable"
    header @adminapp_html Cache-Control "no-cache, must-revalidate"
    root * /var/www/portal/adminapp
    try_files {path} {path}/index.html /index.html
    file_server
  }

  @connect_host host connect.pokrov.space
  handle @connect_host {
    @singbox_rules path /rules/geoip-ru.srs /rules/adblock.srs
    handle @singbox_rules {
      header Content-Type "application/octet-stream"
      header Cache-Control "public, max-age=21600"
      root * /var/www/portal
      file_server
    }

    @subscription path /s8Kx2mP7qR4wT/*
    handle @subscription {
      reverse_proxy 127.0.0.1:8080
    }

    handle {
      redir https://app.pokrov.space{uri} 308
    }
  }

  @api_hosts host api.pokrov.space
  handle @api_hosts {
    @authenticated_egress_probe path /api/public/authenticated-egress-probe
    handle @authenticated_egress_probe {
      header X-Pokrov-Egress-Probe "pokrov-authenticated-egress-v1"
      header Cache-Control "no-store"
      respond "" 204
    }

    @subscription path /s8Kx2mP7qR4wT/*
    handle @subscription {
      reverse_proxy 127.0.0.1:8080
    }

    @api path /api/*
    handle @api {
      reverse_proxy 127.0.0.1:8080
    }

    @pay path /pay/*
    handle @pay {
      reverse_proxy 127.0.0.1:8080
    }

    respond "Not Found" 404
  }

  @pay_host host pay.pokrov.space
  handle @pay_host {
    @subscription path /s8Kx2mP7qR4wT/*
    handle @subscription {
      reverse_proxy 127.0.0.1:8080
    }

    @api path /api/*
    handle @api {
      reverse_proxy 127.0.0.1:8080
    }

    @pay path /pay/*
    handle @pay {
      reverse_proxy 127.0.0.1:8080
    }

    @pay_static path /_next/static/*
    @pay_html {
      not path /_next/static/*
    }
    header @pay_static Cache-Control "public, max-age=31536000, immutable"
    header @pay_html Cache-Control "no-cache, must-revalidate"
    handle {
      root * /var/www/portal/marketing
      try_files {path} {path}/index.html /index.html
      file_server
    }
  }

  @legacy_web_hosts host portal-privacy.online www.portal-privacy.online
  handle @legacy_web_hosts {
    redir https://pokrov.space{uri} 308
  }

  @legacy_connect_hosts host connect.portal-privacy.online
  handle @legacy_connect_hosts {
    redir https://app.pokrov.space{uri} 308
  }

  @legacy_api_hosts host kiwunaka.space www.kiwunaka.space pay.kiwunaka.space
  handle @legacy_api_hosts {
    redir https://api.pokrov.space{uri} 308
  }

  # Unknown hosts default to marketing site.
  handle {
    root * /var/www/portal/marketing
    try_files {path} {path}/index.html /index.html
    file_server
  }
}
