{
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "inbounds": [
    {
      "type": "hysteria2",
      "tag": "pokrov-hy2-lab-in",
      "listen": "0.0.0.0",
      "listen_port": 443,
      "up_mbps": 100,
      "down_mbps": 300,
      "obfs": {
        "type": "salamander",
        "password": "${POKROV_HY2_OBFS_PASSWORD}"
      },
      "users": [
        {
          "name": "${POKROV_HY2_USER_NAME}",
          "password": "${POKROV_HY2_PASSWORD}"
        }
      ],
      "ignore_client_bandwidth": false,
      "tls": {
        "enabled": true,
        "alpn": [
          "h3"
        ],
        "min_version": "1.3",
        "certificate_path": "${POKROV_HY2_CERTIFICATE_PATH}",
        "key_path": "${POKROV_HY2_KEY_PATH}"
      }
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "block",
      "tag": "block"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "final": "direct"
  }
}
