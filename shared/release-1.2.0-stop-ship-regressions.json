  "source_plan": "POKROV_release_1.2.0_full_audit_with_client_logging_RU.md",
  "branch_policy": {
    "review_mode": "OWNER_SOLO_EXCEPTION",
    "require_status_check_app_binding": true,
    "required_pull_request_reviews": {
