      "require_last_push_approval": true
    },
    "enforce_admins": true,
    "required_linear_history": true,
    "required_conversation_resolution": true,
    "required_signatures": true,
    "allow_force_pushes": false,
    "allow_deletions": false,
    "codeowners": {
      "path": ".github/CODEOWNERS",
      "excluded_pr_author": "Kiwunaka",
      "minimum_eligible_non_author_reviewers": 1,
      "selected_code_owners": [],
      "selection_state": "OWNER_SOLO_EXCEPTION"
    },
    "solo_owner_exception": {
      "active": true,
      "release": "1.2.0",
      "owner_login": "Kiwunaka",
      "authorized_at": "2026-08-23",
      "authorization_source": "explicit_owner_instruction_in_codex_task",
      "expires_when": "release_1.2.0_is_closed",
      "waived_controls": [
        "eligible_non_author_pull_request_approval",
        "codeowners_non_author_selection",
