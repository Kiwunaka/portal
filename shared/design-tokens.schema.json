{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pokrov.space/schemas/design-tokens.schema.json",
  "title": "POKROV Design Tokens",
  "type": "object",
  "required": ["theme", "spacing", "brand", "glass", "density", "component", "iconography", "motion", "accessibility"],
  "additionalProperties": false,
  "properties": {
    "theme": {
      "type": "object",
      "required": ["name", "version", "palette", "semantic", "radius", "shadow", "typography"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "palette": {
          "type": "object",
          "required": [
            "canvas",
            "canvas_alt",
            "canvas_dark",
            "canvas_dark_alt",
            "surface",
            "surface_strong",
            "surface_subtle",
            "surface_muted",
            "surface_dark",
            "surface_dark_strong",
            "surface_glass",
            "surface_glass_strong",
            "surface_glass_dark",
            "surface_glass_dark_strong",
            "surface_raised",
            "surface_raised_dark",
            "text",
            "text_soft",
            "text_muted",
            "text_dark",
            "text_dark_soft",
            "text_dark_muted",
            "text_inverse",
            "emerald",
            "emerald_strong",
            "emerald_soft",
            "emerald_dark",
            "mint",
            "mint_strong",
            "sage",
            "gold_soft",
            "line",
            "line_strong",
            "line_dark",
            "line_dark_strong",
            "focus_ring",
            "focus_ring_dark"
          ],
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "semantic": {
          "type": "object",
          "required": ["success", "warning", "danger", "info", "neutral"],
          "additionalProperties": false,
          "properties": {
            "success": { "$ref": "#/$defs/statusToken" },
            "warning": { "$ref": "#/$defs/statusToken" },
            "danger": { "$ref": "#/$defs/statusToken" },
            "info": { "$ref": "#/$defs/statusToken" },
            "neutral": { "$ref": "#/$defs/statusToken" }
          }
        },
        "radius": {
          "type": "object",
          "required": ["card", "panel", "modal", "control", "tile", "pill", "app_connect"],
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "shadow": {
          "type": "object",
          "required": ["soft", "medium", "strong", "soft_dark", "medium_dark", "strong_dark", "focus"],
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "typography": {
          "type": "object",
          "required": [
            "body_family",
            "display_family",
            "mono_family",
            "letter_spacing",
            "compact_line_height",
            "body_line_height"
          ],
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "brand": {
      "type": "object",
      "required": ["public_name", "approved_assets", "legacy_reference_assets", "asset_policy"],
      "additionalProperties": true
    },
    "spacing": {
      "type": "object",
      "required": ["2xs", "xs", "sm", "md", "lg", "xl", "2xl", "3xl"],
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "glass": {
      "type": "object",
      "required": ["content_planes", "overlay_planes", "max_blur", "border_alpha"],
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "density": {
      "type": "object",
      "required": ["public", "cabinet", "admin", "product"],
      "additionalProperties": false,
      "properties": {
        "public": { "$ref": "#/$defs/densityToken" },
        "cabinet": { "$ref": "#/$defs/densityToken" },
        "admin": { "$ref": "#/$defs/densityToken" },
        "product": { "$ref": "#/$defs/densityToken" }
      }
    },
    "component": {
      "type": "object",
      "required": ["button", "nav", "card", "table", "skeleton", "progress", "app_connect"],
      "additionalProperties": false,
      "properties": {
        "button": { "$ref": "#/$defs/buttonToken" },
        "nav": { "$ref": "#/$defs/navToken" },
        "card": { "$ref": "#/$defs/cardToken" },
        "table": { "$ref": "#/$defs/tableToken" },
        "skeleton": { "$ref": "#/$defs/skeletonToken" },
        "progress": { "$ref": "#/$defs/progressToken" },
        "app_connect": { "$ref": "#/$defs/appConnectToken" }
      }
    },
    "iconography": {
      "type": "object",
      "required": ["web_default", "web_shell_legacy", "client_default", "line_weight", "policy"],
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "motion": {
      "type": "object",
      "required": [
        "section_narrative",
        "surface_hover",
        "duration_fast",
        "duration_base",
        "duration_slow",
        "easing",
        "reduced_motion_fallback"
      ],
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "accessibility": {
      "type": "object",
      "required": ["focus_visible", "min_touch_target", "browser_checks", "contrast_floor"],
      "additionalProperties": true
    }
  },
  "$defs": {
    "statusToken": {
      "type": "object",
      "required": ["bg", "text", "line", "bg_dark", "text_dark", "line_dark"],
      "additionalProperties": false,
      "properties": {
        "bg": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "line": { "type": "string", "minLength": 1 },
        "bg_dark": { "type": "string", "minLength": 1 },
        "text_dark": { "type": "string", "minLength": 1 },
        "line_dark": { "type": "string", "minLength": 1 }
      }
    },
    "buttonToken": {
      "type": "object",
      "required": [
        "height",
        "compact_height",
        "radius",
        "icon_size",
        "background",
        "background_hover",
        "background_dark",
        "background_dark_hover",
        "text",
        "text_dark",
        "secondary_background",
        "secondary_background_dark",
        "border",
        "border_dark"
      ],
      "additionalProperties": false,
      "properties": {
        "height": { "type": "string", "minLength": 1 },
        "compact_height": { "type": "string", "minLength": 1 },
        "radius": { "type": "string", "minLength": 1 },
        "icon_size": { "type": "string", "minLength": 1 },
        "background": { "type": "string", "minLength": 1 },
        "background_hover": { "type": "string", "minLength": 1 },
        "background_dark": { "type": "string", "minLength": 1 },
        "background_dark_hover": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "text_dark": { "type": "string", "minLength": 1 },
        "secondary_background": { "type": "string", "minLength": 1 },
        "secondary_background_dark": { "type": "string", "minLength": 1 },
        "border": { "type": "string", "minLength": 1 },
        "border_dark": { "type": "string", "minLength": 1 }
      }
    },
    "navToken": {
      "type": "object",
      "required": [
        "item_min_height",
        "icon_size",
        "active_bg",
        "active_bg_dark",
        "hover_bg",
        "hover_bg_dark",
        "text",
        "text_dark"
      ],
      "additionalProperties": false,
      "properties": {
        "item_min_height": { "type": "string", "minLength": 1 },
        "icon_size": { "type": "string", "minLength": 1 },
        "active_bg": { "type": "string", "minLength": 1 },
        "active_bg_dark": { "type": "string", "minLength": 1 },
        "hover_bg": { "type": "string", "minLength": 1 },
        "hover_bg_dark": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "text_dark": { "type": "string", "minLength": 1 }
      }
    },
    "cardToken": {
      "type": "object",
      "required": [
        "border",
        "border_dark",
        "background",
        "background_dark",
        "inner_edge",
        "inner_edge_dark"
      ],
      "additionalProperties": false,
      "properties": {
        "border": { "type": "string", "minLength": 1 },
        "border_dark": { "type": "string", "minLength": 1 },
        "background": { "type": "string", "minLength": 1 },
        "background_dark": { "type": "string", "minLength": 1 },
        "inner_edge": { "type": "string", "minLength": 1 },
        "inner_edge_dark": { "type": "string", "minLength": 1 }
      }
    },
    "tableToken": {
      "type": "object",
      "required": [
        "row_height",
        "header_bg",
        "header_bg_dark",
        "divider",
        "divider_dark",
        "row_hover_bg",
        "row_hover_bg_dark"
      ],
      "additionalProperties": false,
      "properties": {
        "row_height": { "type": "string", "minLength": 1 },
        "header_bg": { "type": "string", "minLength": 1 },
        "header_bg_dark": { "type": "string", "minLength": 1 },
        "divider": { "type": "string", "minLength": 1 },
        "divider_dark": { "type": "string", "minLength": 1 },
        "row_hover_bg": { "type": "string", "minLength": 1 },
        "row_hover_bg_dark": { "type": "string", "minLength": 1 }
      }
    },
    "skeletonToken": {
      "type": "object",
      "required": ["base", "highlight", "base_dark", "highlight_dark"],
      "additionalProperties": false,
      "properties": {
        "base": { "type": "string", "minLength": 1 },
        "highlight": { "type": "string", "minLength": 1 },
        "base_dark": { "type": "string", "minLength": 1 },
        "highlight_dark": { "type": "string", "minLength": 1 }
      }
    },
    "progressToken": {
      "type": "object",
      "required": ["track", "track_dark", "fill", "fill_dark", "warning_fill", "danger_fill"],
      "additionalProperties": false,
      "properties": {
        "track": { "type": "string", "minLength": 1 },
        "track_dark": { "type": "string", "minLength": 1 },
        "fill": { "type": "string", "minLength": 1 },
        "fill_dark": { "type": "string", "minLength": 1 },
        "warning_fill": { "type": "string", "minLength": 1 },
        "danger_fill": { "type": "string", "minLength": 1 }
      }
    },
    "appConnectToken": {
      "type": "object",
      "required": ["size_mobile", "size_desktop", "ring"],
      "additionalProperties": false,
      "properties": {
        "size_mobile": { "type": "string", "minLength": 1 },
        "size_desktop": { "type": "string", "minLength": 1 },
        "ring": { "type": "string", "minLength": 1 }
      }
    },
    "densityToken": {
      "type": "object",
      "required": ["card_padding", "panel_padding", "grid_gap", "section_gap", "radius_card", "radius_panel"],
      "additionalProperties": false,
      "properties": {
        "card_padding": { "type": "string", "minLength": 1 },
        "panel_padding": { "type": "string", "minLength": 1 },
        "grid_gap": { "type": "string", "minLength": 1 },
        "section_gap": { "type": "string", "minLength": 1 },
        "radius_card": { "type": "string", "minLength": 1 },
        "radius_panel": { "type": "string", "minLength": 1 }
      }
    }
  }
}
