{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pokrov.space/schemas/support-collection-policy-v2.schema.json",
  "title": "POKROV temporary support-mode collection policy payload v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "allowed_categories",
    "allowed_collectors",
    "audience",
    "expires_at",
    "issued_at",
    "maximum_bundle_bytes",
    "maximum_bundles",
    "maximum_total_bytes",
    "nonce",
    "policy_id",
    "profile",
    "schema_version",
    "type"
  ],
  "properties": {
    "allowed_categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "build",
          "crashes",
          "events",
          "network",
          "redaction",
          "system"
        ]
      }
    },
    "allowed_collectors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "build_summary",
          "crash_index",
          "network_summary",
          "operational_events",
          "redaction_report",
          "system_summary"
        ]
      }
    },
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["app_version", "build_number", "platform"],
      "properties": {
        "app_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:\\+[0-9]+)?$"
        },
        "build_number": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,79}$"
        },
        "platform": {
          "enum": ["android", "windows"]
        }
      }
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "maximum_bundle_bytes": {
      "type": "integer",
      "minimum": 65536,
      "maximum": 2097152
    },
    "maximum_bundles": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "maximum_total_bytes": {
      "type": "integer",
      "minimum": 65536,
      "maximum": 4194304
    },
    "nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$"
    },
    "policy_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{7,63}$"
    },
    "profile": {
      "const": "extended"
    },
    "schema_version": {
      "const": 2
    },
    "type": {
      "const": "pokrov.support.collection_policy"
    }
  }
}
