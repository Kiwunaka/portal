{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pokrov.space/schemas/support-key-set-v1.schema.json",
  "title": "POKROV support recipient key set payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "expires_at",
    "issued_at",
    "keys",
    "schema_version",
    "type"
  ],
  "properties": {
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/recipient"
      }
    },
    "schema_version": {
      "const": 1
    },
    "type": {
      "const": "pokrov.support.key_set"
    }
  },
  "$defs": {
    "recipient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "not_after",
        "public_key_b64"
      ],
      "properties": {
        "algorithm": {
          "const": "X25519-HKDF-SHA256-AES-256-GCM"
        },
        "key_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
        },
        "not_after": {
          "type": "string",
          "format": "date-time"
        },
        "public_key_b64": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      }
    }
  }
}
